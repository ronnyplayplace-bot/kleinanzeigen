# Copy this file to .env (or set these as environment variables on your n8n
# instance) and fill in your own values. Never commit your real .env file.
#
# NOTE: n8n only reads $env.* inside workflow expressions if the instance has
# access to environment variables. On self-hosted n8n (Docker/npm) this works
# out of the box — pass the vars via `docker run -e ...`, a docker-compose
# `environment:` block, or your systemd/PM2 env file. On n8n Cloud, env vars
# are NOT exposed to workflows by default, so you'd need to hardcode the
# webhook URL directly in the "Discord - PC deals" node instead.

# Required: your Discord webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: point the scraper at a different kleinanzeigen.de search instead
# of "PCs near Wuerzburg". Easiest way to get this: go to kleinanzeigen.de,
# set your category + city + radius, run the search, copy the URL from your
# browser and paste it here WITHOUT the "?sortingField=..." part at the end.
# Leave empty to use the built-in Wuerzburg default.
KLEINANZEIGEN_SEARCH_URL=https://www.kleinanzeigen.de/s-pcs/wuerzburg/c228l7667r30

# Optional: label shown in the Discord message header, e.g. "Berlin +/- 20 km"
SEARCH_AREA_LABEL=Wuerzburg +/- 30 km
